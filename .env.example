# .env.example → .env로 복사해서 씁니다 (.env에는 키가 들어가니 남에게 주거나 올리지 않음)

# ── DB: 하나만 고르기 ──
# ① Supabase (기본 · 7일차 프로젝트)
#    대시보드 → Project Settings → API Keys → Secret keys (공개 키 Publishable이 아니라 서버 전용 Secret)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ② SQLite (사내 방식 · 키 없음) — 위 두 줄을 지우고 아래 줄 맨 앞의 #을 지움
# DB_MODE=sqlite

# 포트를 바꾸려면 (기본 8080)
# PORT=8081
